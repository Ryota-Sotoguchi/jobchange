# ローカル開発では、このファイルを .env.local にコピーして値を設定してください。
#   cp .env.example .env.local
# .env.local は Git 管理されません（.gitignore 済み）。

# OpenAI の APIキー（サーバー側でのみ使用。ブラウザには送られません）
# 未設定の場合は自動的に「開発モード（モック結果）」で動作します。
OPENAI_API_KEY=

# 使用するモデル（既定: gpt-6-luna）。品質を上げたい場合は gpt-6.1-sol などに変更
OPENAI_MODEL=gpt-6-luna

# mock を指定すると、APIキーがあってもモック結果を返します（UI確認用）
ANALYSIS_MODE=

# モックモードの動作（開発時のエラー表示確認用）
#   success（既定） / api_error / invalid_response / slow
MOCK_SCENARIO=

# モックモードで結果を返すまでの待ち時間（ミリ秒、既定 1200）
MOCK_DELAY_MS=
